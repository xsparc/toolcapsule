{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration summary bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "before",
    "after",
    "difference",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "configuration_summary_bundle"
    },
    "before": {
      "$ref": "#/$defs/summary"
    },
    "after": {
      "$ref": "#/$defs/summary"
    },
    "difference": {
      "$ref": "#/$defs/difference"
    },
    "interpretation": {
      "const": "summary_consistency_not_source_identity_or_authority"
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "configuration"
        },
        "valid": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "properties": {
            "limits": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "valid"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "invalid"
                    },
                    "error": {
                      "enum": [
                        "invalid_format",
                        "invalid_configuration",
                        "input_too_large",
                        "io_error",
                        "validation_failed"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "policy": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "valid"
                    },
                    "denies_all_tools": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "denies_all_tools"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "invalid"
                    },
                    "error": {
                      "enum": [
                        "invalid_format",
                        "invalid_configuration",
                        "input_too_large",
                        "io_error",
                        "validation_failed"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "trust": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "valid"
                    },
                    "denies_all_signers": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "denies_all_signers"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "invalid"
                    },
                    "error": {
                      "enum": [
                        "invalid_format",
                        "invalid_configuration",
                        "input_too_large",
                        "io_error",
                        "validation_failed"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "limits",
            "policy",
            "trust"
          ],
          "additionalProperties": false
        },
        "budget_fit": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "fits",
                "exceeds",
                "not_checked"
              ]
            },
            "exceeded_fields": {
              "type": "array",
              "items": {
                "enum": [
                  "fuel",
                  "memory_bytes",
                  "timeout_ms",
                  "input_bytes",
                  "output_bytes"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "exceeded_fields"
          ],
          "additionalProperties": false
        },
        "package_admission": {
          "const": "not_checked"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "valid",
        "checks",
        "budget_fit",
        "package_admission"
      ],
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "configuration_difference"
        },
        "direction": {
          "const": "before_to_after"
        },
        "identical_summaries": {
          "type": "boolean"
        },
        "before": {
          "$ref": "#/$defs/summary"
        },
        "after": {
          "$ref": "#/$defs/summary"
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "enum": [
              "/valid",
              "/checks/limits/status",
              "/checks/limits/error",
              "/checks/policy/status",
              "/checks/policy/error",
              "/checks/policy/denies_all_tools",
              "/checks/trust/status",
              "/checks/trust/error",
              "/checks/trust/denies_all_signers",
              "/budget_fit/status",
              "/budget_fit/exceeded_fields"
            ]
          },
          "maxItems": 11,
          "uniqueItems": true
        },
        "interpretation": {
          "const": "summary_changes_not_source_identity_or_authority"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "direction",
        "identical_summaries",
        "before",
        "after",
        "changed_fields",
        "interpretation"
      ]
    }
  }
}
